@model List<CartItem>
@{ ViewData["Title"] = "Cart"; }

<h2 class="mb-4">🛒 Your Cart</h2>

@if (!Model.Any())
{
    <p class="text-muted">Your cart is empty (´･_･`)</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-navy">Browse Plushies</a>
}
else
{
    @* ✿ One card per cart item ✿ *@
    @foreach (CartItem item in Model)
    {
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <div class="flex-grow-1">
                    <h5 class="mb-0">@item.ProductName</h5>
                    <span class="price">₱@(item.Price.ToString("N2"))</span>
                </div>

                <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="width:90px" />
                    <button type="submit" class="btn btn-pastel">Update</button>
                </form>

                <div>Subtotal: <b>₱@((item.Price * item.Quantity).ToString("N2"))</b></div>

                <form asp-action="Remove" method="post">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-ink">Remove</button>
                </form>
            </div>
        </div>
    }

    @* ✿ Total ✿ *@
    var total = Model.Sum(i => i.Price * i.Quantity);
    <div class="card total-card">
        <div class="card-body text-end">
            <h4 class="mb-0">Total: <span class="price">₱@(total.ToString("N2"))</span></h4>
        </div>
    </div>
}